# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=payroll
DB_PASSWORD=payroll
DB_NAME=payroll

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Paystack (use TEST keys from your Paystack dashboard)
PAYSTACK_SECRET_KEY=your_paystack_test_secret_key
PAYSTACK_CALLBACK_URL=http://localhost:3000/api

# Background worker settlement endpoint
WORKER_API_KEY=change-me-worker-key

# Superadmin (seeded on startup if not present)
SUPERADMIN_EMAIL=super@payroll.local
SUPERADMIN_PASSWORD=change-me-super
# Default automated-payroll fee per employee, minor units (e.g. kobo). 0 = no fee.
DEFAULT_PAYROLL_FEE=0

# Mail (SMTP). If SMTP_HOST is unset, emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Payroll <no-reply@payroll.local>

# App
PORT=3000
